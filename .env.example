# Copia este archivo a `.env` y rellena los valores.
# `.env` no se sube a git: es el unico sitio donde viven las claves.

# Clave de la API de OpenAI (https://platform.openai.com/api-keys)
# Se puede dejar vacia y ponerla desde la web, en Ajustes.
OPENAI_API_KEY=

# Modelo. Ejecuta `npm run modelos` para ver los disponibles en tu cuenta.
# gpt-4.1    -> el que usa por defecto: rapido y no exige verificar la cuenta
# gpt-5      -> maxima calidad
# gpt-5-mini -> mas barato
MODEL=gpt-4.1

# Solo para modelos de razonamiento (gpt-5, o3, o4...). Mas bajo = mas rapido.
# minimal | low | medium | high   — dejalo vacio para no enviarlo.
REASONING_EFFORT=

# Si la clave falla (caducada, mal copiada o sin saldo), en vez de dar error
# se pasa solo al modo de prueba y lo avisa en pantalla. Pon 0 para desactivarlo.
FALLBACK_SIMULADO=1

# MOCK=1 fuerza el modo de prueba siempre, sin llamar nunca a la API.
# MOCK=0

# --- Acceso a la aplicacion -------------------------------------------------
APP_USER=maiko

# SIN VALOR POR DEFECTO A PROPOSITO. Mientras este vacia nadie puede entrar.
# Ponle algo largo: es lo unico que separa las conversaciones de tus clientas
# de cualquiera que de con la direccion.
APP_PASSWORD=

# Firma la cookie de sesion. Tiene que ser largo y aleatorio, y NO puede ser
# el mismo que use ningun otro sitio. Generalo con:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si se deja vacio, la aplicacion inventa uno nuevo en cada arranque y todo el
# mundo tiene que volver a entrar cada vez que se reinicia.
SESSION_SECRET=

# --- Servidor ---------------------------------------------------------------
PORT=3010

# Interfaz en la que escucha. 127.0.0.1 = solo nginx puede llegar, que es lo
# que se quiere cuando hay un proxy delante. 0.0.0.0 la abre a toda la red.
HOST=127.0.0.1

# Donde se guardan ajustes, clientes y estilo.
# Vacio = la carpeta config/ del repositorio, solo para probar.
# En el servidor, FUERA del repositorio, o un `git pull` borra las
# conversaciones:  DATA_DIR=C:\asistente-datos
DATA_DIR=

# En produccion la cookie de sesion viaja como `secure`, asi que solo funciona
# por HTTPS. Dejalo sin poner si pruebas en local por http://localhost.
NODE_ENV=production
