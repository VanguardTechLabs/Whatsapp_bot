# Copia este archivo a `.env` y rellena los valores.

# Clave de la API de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Modelo. Ejecuta `npm run modelos` para ver los disponibles en tu cuenta.
# gpt-5      -> maxima calidad
# gpt-5-mini -> mas rapido y mas barato (suele bastar para esto)
MODEL=gpt-5

# Solo para modelos de razonamiento (gpt-5, o3, o4...). Mas bajo = mas rapido.
# minimal | low | medium | high   — dejalo vacio para no enviarlo.
REASONING_EFFORT=low

# Si la clave falla (caducada, mal copiada o sin saldo), en vez de dar error
# se pasa solo al modo de prueba y lo avisa en pantalla. Pon 0 para desactivarlo.
FALLBACK_SIMULADO=1

# MOCK=1 fuerza el modo de prueba siempre, sin llamar nunca a la API.
# MOCK=0

# Acceso a la aplicacion
APP_USER=maiko
APP_PASSWORD=cambia-esta-clave

# Clave para firmar la cookie de sesion (cualquier texto largo y aleatorio)
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Donde se guardan ajustes, clientes y estilo.
# En local se puede dejar vacio (usa config/). En un servidor apunta a un
# volumen, o se pierde todo en cada despliegue:  DATA_DIR=/data
DATA_DIR=

PORT=3000
